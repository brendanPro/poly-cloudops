. "$(dirname -- "$0")/_/husky.sh"

#
# Git branch naming validation hook (blocking)
# Prevents pushing branches with invalid names
# Based on Conventional Commits format
# See: https://www.conventionalcommits.org/
#

branch_name=$(git symbolic-ref --short HEAD 2>/dev/null)
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

valid_types="feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert"
protected_branches="^(main|master|develop|staging|production)$"

if echo "$branch_name" | grep -qE "$protected_branches"; then
    exit 0
fi

if ! echo "$branch_name" | grep -qE "^($valid_types)/[a-z0-9]+(-[a-z0-9]+)*(/[a-z0-9]+(-[a-z0-9]+)*)?$"; then
    printf "${RED}❌ Push rejected: Invalid branch name format!${NC}\n"
    printf "\n"
    printf "${YELLOW}Your branch name:${NC}\n"
    printf "  %s\n" "$branch_name"
    printf "\n"
    printf "${YELLOW}Expected format:${NC}\n"
    printf "  <type>/<description>\n"
    printf "  <type>/<scope>/<description>\n"
    printf "\n"
    printf "${YELLOW}Valid types:${NC} feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert\n"
    printf "\n"
    printf "${YELLOW}Rules:${NC}\n"
    printf "  • Use kebab-case (lowercase with hyphens) for descriptions\n"
    printf "  • No uppercase letters, spaces, or special characters\n"
    printf "  • Description should be concise and meaningful\n"
    printf "\n"
    printf "${YELLOW}Valid examples:${NC}\n"
    printf "  feat/user-authentication\n"
    printf "  fix/api/connection-timeout\n"
    printf "  docs/update-readme\n"
    printf "  ci/dagger/add-build-workflow\n"
    printf "  refactor/terraform/cloud-run-service\n"
    printf "\n"
    printf "${YELLOW}To rename your current branch:${NC}\n"
    printf "  git branch -m <new-branch-name>\n"
    printf "\n"
    exit 1
fi

printf "${GREEN}✅ Branch name format is valid!${NC}\n"
