. "$(dirname -- "$0")/_/husky.sh"

#
# Git branch naming validation hook (warning only)
# Provides friendly advice when checking out branches with invalid names
# Based on Conventional Commits format
# See: https://www.conventionalcommits.org/
#

# post-checkout receives 3 parameters:
# $1: ref of the previous HEAD
# $2: ref of the new HEAD
# $3: flag indicating whether it was a branch checkout (1) or file checkout (0)

# Only check on branch checkout
if [ "$3" = "0" ]; then
    exit 0
fi

# Get the current branch name
branch_name=$(git symbolic-ref --short HEAD 2>/dev/null)

# If we can't get the branch name (detached HEAD), skip
if [ -z "$branch_name" ]; then
    exit 0
fi

# Colors for output
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Valid branch types (matching commit types)
valid_types="feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert"

# Protected branches that are allowed (main, master, develop, etc.)
protected_branches="^(main|master|develop|staging|production)$"

# Check if we're on a protected branch (these are allowed)
if echo "$branch_name" | grep -qE "$protected_branches"; then
    exit 0
fi

# Check if branch name matches conventional format
if ! echo "$branch_name" | grep -qE "^($valid_types)/[a-z0-9]+(-[a-z0-9]+)*(/[a-z0-9]+(-[a-z0-9]+)*)?$"; then
    printf "\n"
    printf "${YELLOW}⚠️  Warning: Branch name doesn't follow the naming convention${NC}\n"
    printf "\n"
    printf "${CYAN}Current branch:${NC}\n"
    printf "  %s\n" "$branch_name"
    printf "\n"
    printf "${CYAN}Expected format:${NC}\n"
    printf "  <type>/<description> or <type>/<scope>/<description>\n"
    printf "\n"
    printf "${CYAN}Valid types:${NC} feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert\n"
    printf "\n"
    printf "${CYAN}Examples:${NC}\n"
    printf "  feat/user-authentication\n"
    printf "  fix/api/connection-timeout\n"
    printf "  docs/update-readme\n"
    printf "\n"
    printf "${CYAN}💡 To rename your branch:${NC}\n"
    printf "  git branch -m %s <new-branch-name>\n" "$branch_name"
    printf "\n"
    printf "${YELLOW}Note:${NC} You can continue working, but the push will be blocked until the name is fixed.\n"
    printf "\n"
fi

exit 0
