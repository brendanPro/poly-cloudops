. "$(dirname -- "$0")/_/husky.sh"

#
# Git branch naming hook to enforce conventional branch naming
# Based on Conventional Commits format
# See: https://www.conventionalcommits.org/
#

# Get the current branch name
branch_name=$(git symbolic-ref --short HEAD 2>/dev/null)

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Valid branch types (matching commit types)
valid_types="feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert"

# Protected branches that are allowed (main, master, develop, etc.)
protected_branches="^(main|master|develop|staging|production)$"

# Check if we're on a protected branch (these are allowed)
if echo "$branch_name" | grep -qE "$protected_branches"; then
    exit 0
fi

# Check if branch name matches conventional format
# Format: <type>/<description> or <type>/<scope>/<description>
# Description should use kebab-case (lowercase with hyphens)
# Examples: feat/user-authentication, fix/api/connection-timeout
if ! echo "$branch_name" | grep -qE "^($valid_types)/[a-z0-9]+(-[a-z0-9]+)*(/[a-z0-9]+(-[a-z0-9]+)*)?$"; then
    echo "${RED}❌ Invalid branch name format!${NC}"
    echo ""
    echo "${YELLOW}Your branch name:${NC}"
    echo "  $branch_name"
    echo ""
    echo "${YELLOW}Expected format:${NC}"
    echo "  <type>/<description>"
    echo "  <type>/<scope>/<description>"
    echo ""
    echo "${YELLOW}Valid types:${NC} feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
    echo ""
    echo "${YELLOW}Rules:${NC}"
    echo "  • Use kebab-case (lowercase with hyphens) for descriptions"
    echo "  • No uppercase letters, spaces, or special characters"
    echo "  • Description should be concise and meaningful"
    echo ""
    echo "${YELLOW}Valid examples:${NC}"
    echo "  feat/user-authentication"
    echo "  fix/api/connection-timeout"
    echo "  docs/update-readme"
    echo "  ci/dagger/add-build-workflow"
    echo "  refactor/terraform/cloud-run-service"
    echo ""
    echo "${YELLOW}To rename your current branch:${NC}"
    echo "  git branch -m <new-branch-name>"
    echo ""
    exit 1
fi

echo "${GREEN}✅ Branch name format is valid!${NC}"
