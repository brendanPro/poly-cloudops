# ==================================================
# Poly-CloudOps Frontend Environment Variables
# ==================================================
# Copy this file to .env.local for local development
# or set these variables in your deployment environment

# Translation workflow webhook
N8N_TRANSLATE_WEBHOOK_URL=http://localhost:5678/webhook/translation

# QR Code workflow webhook
N8N_QR_WEBHOOK_URL=http://localhost:5678/webhook/generateQr

# JSON to Excel workflow webhook
N8N_JSON_EXCEL_WEBHOOK_URL=http://localhost:5678/webhook/c1616754-4dec-4b00-a8b5-d1cb5f75bf11

# AI Text Summarizer workflow webhook
N8N_SUMMARIZE_WEBHOOK_URL=http://localhost:5678/webhook/ai-summarizer

# Weather Forecast workflow webhook
N8N_WEATHER_WEBHOOK_URL=http://localhost:5678/webhook/weather

# Currency Converter workflow webhook
N8N_CURRENCY_WEBHOOK_URL=http://localhost:5678/webhook/currency

# ==================================================
# Optional: Next.js Configuration
# ==================================================

# Port for the Next.js server (default: 3000)
# Cloud Run will override this with its own PORT variable
# PORT=3000

# Node Environment
# NODE_ENV=production
