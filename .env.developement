# --- Networking ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

N8N_URL=http://localhost:5678 

# --- Database Credentials (utilisées par le script bootstrap) ---
PGHOST=postgres
PGPORT=5432
PGDATABASE=n8n_db
PGUSER=local_admin
PGPASSWORD=local_password

# --- n8n Database Internal Config (utilisée par le conteneur n8n) ---
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n_db
DB_POSTGRESDB_USER=local_admin
DB_POSTGRESDB_PASSWORD=local_password
DB_POSTGRESDB_SSL_ENABLED=false

# --- n8n Admin Account (utilisé par insertUserSql.js) ---
# L'email que tu souhaites injecter en base de données
N8N_ADMIN_EMAIL=admin@cloudops.com
# Le mot de passe en clair correspondant au hash SQL 
N8N_ADMIN_PASSWORD=monSuperMotDePasse123!

# --- Security (CRITIQUE) ---
# Génère une clé aléatoire pour ton instance locale
N8N_ENCRYPTION_KEY=

# --- Integrations (CRITIQUE) ---
# Ta clé API DeepL personnelle
DEEPL_API_KEY=